 56%)."],[13.889,44.59,52.931,1.809,1.634,"Our Dec-27 target of ₹305 averages the two methods used for Swiggy. A 37x"],[13.889,46.034,52.934,1.809,1.634,"P/E, midway between the medians of Indian internet and consumer names (52x)"],[13.889,47.502,52.951,1.809,1.634,"and global delivery platforms (22x), on fully-taxed FY31E EPS of ₹12.4,"],[13.889,48.946,52.936,1.809,1.634,"discounted at 12%, gives ₹355. A DCF to FY36E plus cash gives ₹255. Blinkit"],[13.889,50.39,52.936,1.809,1.634,"decides the answer: at a long-run margin of 4.5% of NOV the target is ₹260, at"],[13.889,51.834,52.931,1.809,1.634,"6.5% ₹350. We use 5.5%; the price implies 6.8%, above the top of guidance, on"],[13.889,53.278,52.936,1.809,1.634,"NOV that grows 13-fold in ten years. Consensus target: ₹384. Upside: Blinkit"],[13.889,54.722,52.931,1.809,1.634,"margins above 6%; dark.ai. Downside: a five-to-seven-player quick-commerce"],[13.889,56.167,17.535,1.809,1.634,"market; new food entrants."],[13.889,58.654,13.042,1.643,1.471,"Price Performance"],[15.268,67.265,1.489,1.022,0.915,"200"],[15.268,65.498,1.489,1.022,0.915,"250"],[15.268,63.73,1.489,1.022,0.915,"300"],[15.268,61.962,1.489,1.022,0.915,"350"],[15.268,60.195,1.489,1.022,0.915,"400"],[18.306,67.96,2.796,1.022,0.915,"Jan 26"],[22.929,67.96,2.796,1.022,0.915,"Apr 26"],[27.701,67.96,2.47,1.022,0.915,"Jul 26"],[32.473,67.96,2.96,1.022,0.915,"Oct 26"],[18.561,69.131,3.398,1.275,1.111,"Eternal ("],[21.962,69.157,0.618,1.241,1.111,"₹"],[22.574,69.131,0.303,1.275,1.111,")"],[25.658,69.131,7.901,1.275,1.111,"NIFTY 50 (rebased)"],[20.291,70.291,1.972,1.387,1.209,"YTD"],[25.561,70.291,1.433,1.387,1.209,"1m"],[30.279,70.291,1.433,1.387,1.209,"3m"],[34.446,70.291,1.984,1.387,1.209,"12m"],[15.277,71.356,1.691,1.387,1.209,"Abs"],[19.372,71.356,2.811,1.387,1.209,"30.8%"],[24.09,71.356,2.811,1.387,1.209,"13.5%"],[28.808,71.356,2.811,1.387,1.209,"14.4%"],[33.527,71.356,2.811,1.387,1.209,"22.1%"],[15.492,72.421,1.476,1.387,1.209,"Rel"],[19.372,72.421,2.811,1.3